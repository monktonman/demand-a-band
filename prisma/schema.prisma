generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  hashedPassword   String?
  emailVerified    DateTime?
  image            String?
  role             UserRole  @default(FAN)
  stripeCustomerId String?   @unique
  onboarded        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  bandPreferences  UserBandPreference[]
  cityPreferences  UserCityPreference[]
  genrePreferences UserGenrePreference[]
  pledges         Pledge[]
  notifications   Notification[]
  dreamShows      DreamShow[]      @relation("dreamShowCreator")
  dreamShowVotes  DreamShowVote[]  @relation("dreamShowVoter")
}

enum UserRole {
  FAN
  OPERATOR
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// BANDS
// ============================================

model Band {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  genres           String[]
  imageUrl         String?
  spotifyId        String?  @unique
  spotifyUrl       String?
  popularity       Int?
  monthlyListeners Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userPreferences UserBandPreference[]
  events          Event[]
  dreamShows      DreamShow[]
}

// ============================================
// USER PREFERENCES (the core demand signal)
// ============================================

model UserBandPreference {
  id             String   @id @default(cuid())
  userId         String
  bandId         String
  maxTicketPrice Decimal  @db.Decimal(10, 2)
  priority       Int      @default(1)
  isDreamShow    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@unique([userId, bandId])
  @@index([bandId])
}

model UserCityPreference {
  id        String   @id @default(cuid())
  userId    String
  city      String
  state     String
  maxRadius Int      @default(30)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, city, state])
}

model UserGenrePreference {
  id        String   @id @default(cuid())
  userId    String
  genre     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, genre])
  @@index([genre])
}

// ============================================
// VENUES
// ============================================

model Venue {
  id         String         @id @default(cuid())
  name       String
  slug       String         @unique
  address    String
  city       String
  state      String
  zipCode    String
  latitude   Decimal?       @db.Decimal(10, 7)
  longitude  Decimal?       @db.Decimal(10, 7)
  capacity   Int
  venueType  String
  genres     String[]
  imageUrl   String?
  websiteUrl String?
  ownership  VenueOwnership @default(INDEPENDENT)
  isActive   Boolean        @default(true)
  notes      String?        @db.Text
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  events     Event[]
  dreamShows DreamShow[]
}

enum VenueOwnership {
  INDEPENDENT
  CHAIN
  NONPROFIT
}

// ============================================
// EVENTS (the core marketplace object)
// ============================================

model Event {
  id             String      @id @default(cuid())
  bandId         String
  venueId        String
  title          String
  slug           String      @unique
  description    String?     @db.Text
  // Availability window — the range of dates the band+venue are available
  windowStart    DateTime?
  windowEnd      DateTime?
  // Final confirmed date (set when event is confirmed; initially a target/estimate)
  eventDate      DateTime
  doorsTime      DateTime?
  showTime       DateTime?
  ticketPrice    Decimal     @db.Decimal(10, 2)
  serviceFee     Decimal     @db.Decimal(10, 2)
  minPledges     Int
  maxCapacity    Int
  status         EventStatus @default(PROPOSED)
  pledgeDeadline DateTime
  imageUrl       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  confirmedAt    DateTime?
  cancelledAt    DateTime?

  band    Band     @relation(fields: [bandId], references: [id])
  venue   Venue    @relation(fields: [venueId], references: [id])
  pledges Pledge[]

  @@index([status])
  @@index([eventDate])
  @@index([bandId])
  @@index([venueId])
}

enum EventStatus {
  PROPOSED
  THRESHOLD_MET
  CONFIRMED
  CANCELLED
  COMPLETED
}

// ============================================
// PLEDGES
// ============================================

model Pledge {
  id                    String       @id @default(cuid())
  userId                String
  eventId               String
  quantity              Int          @default(1)
  totalAmount           Decimal      @db.Decimal(10, 2)
  status                PledgeStatus @default(ACTIVE)
  stripePaymentIntentId String?      @unique
  stripePaymentMethodId String?
  chargedAt             DateTime?
  refundedAt            DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([status])
}

enum PledgeStatus {
  ACTIVE
  PAYMENT_FAILED
  CHARGED
  REFUNDED
  CANCELLED
}

// ============================================
// DREAM SHOWS (social demand building)
// ============================================

model DreamShow {
  id             String   @id @default(cuid())
  shareCode      String   @unique
  creatorId      String
  bandId         String
  venueId        String?  // optional — specific venue assigned later by promoter
  venueSize      String?  // e.g., "intimate", "club", "theater", "large"
  venueSizeLabel String?  // e.g., "Intimate (under 200)"
  maxTicketPrice Decimal  @db.Decimal(10, 2)
  priceTierLabel String   // e.g., "$200–500"
  message        String?  @db.Text  // optional personal pitch
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  creator User           @relation("dreamShowCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  band    Band           @relation(fields: [bandId], references: [id])
  venue   Venue?         @relation(fields: [venueId], references: [id])
  votes   DreamShowVote[]

  @@index([shareCode])
  @@index([bandId])
  @@index([creatorId])
}

model DreamShowVote {
  id          String   @id @default(cuid())
  dreamShowId String
  userId      String?  // null if anonymous / not logged in
  voterName   String?  // for display even if anon
  voterEmail  String?  // optional contact
  createdAt   DateTime @default(now())

  dreamShow DreamShow @relation(fields: [dreamShowId], references: [id], onDelete: Cascade)
  user      User?     @relation("dreamShowVoter", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([dreamShowId, userId])
  @@index([dreamShowId])
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  eventId   String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

enum NotificationType {
  EVENT_CREATED
  THRESHOLD_MET
  EVENT_CONFIRMED
  EVENT_CANCELLED
  PAYMENT_FAILED
  PLEDGE_REMINDER
}
